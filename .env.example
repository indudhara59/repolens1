# GitHub — fine-grained personal access token, "Public Repositories (read-only)" scope
# Create one at: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# Upstash Redis — free database at https://console.upstash.com/redis
# Used to cache GitHub API responses, track indexing progress, and rate-limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash Vector — free index at https://console.upstash.com/vector
# Create the index with 768 dimensions and cosine similarity (text-embedding-004's output size).
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Google Gemini — free API key from Google AI Studio: https://aistudio.google.com/apikey
# Used for embeddings (indexing + retrieval) and chat answer generation.
GEMINI_API_KEY=

# Optional — your deployed URL, used to resolve absolute Open Graph image
# URLs. Defaults to http://localhost:3000 if unset. Set this on Vercel to
# your production domain after deploying.
NEXT_PUBLIC_SITE_URL=
